# Supabase project credentials — read in src/redux/supabaseClient.js
# Copy this file to .env.local and fill in the values from your Supabase
# project settings (Project Settings -> API). Only VITE_-prefixed vars are
# exposed to the app by Vite.

VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
